# OpenHuntX WebGuard example environment controls.
#
# This file intentionally contains no secrets. Do not add API tokens, private
# keys, customer credentials, authorisation documents, or production values.

# Integration tests are network-disabled unless explicitly opted in.
WEBGUARD_RUN_INTEGRATION=0

# Local authorised laboratory target used when integration tests are enabled.
WEBGUARD_LAB_TARGET=http://127.0.0.1:3000/

# Do NOT persist WEBGUARD_API_TOKEN in .env files. The README demonstrates
# interactive entry for local API use so the raw Bearer token is not committed.
